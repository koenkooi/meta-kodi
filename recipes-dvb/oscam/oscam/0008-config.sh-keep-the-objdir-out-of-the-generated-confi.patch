From 3adab905d9a4a3a38975aefacda5df9155affe4a Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Fri, 7 Aug 2026 10:16:19 +0200
Subject: [PATCH 08/10] config.sh: keep the objdir out of the generated
 config.c

make_config_c() wrote the absolute --objdir into a comment at the top of
config.c. That file is compiled in and shipped as a debug source, so the
build directory leaked into the package. The path adds nothing to the
comment. config.mak itself is CONFIG_ lines only, so nothing else leaks.

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>
Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Upstream-Status: Pending
---
 config.sh | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/config.sh b/config.sh
index e7ea074..6ada627 100755
--- a/config.sh
+++ b/config.sh
@@ -365,7 +365,9 @@ make_config_c() {
 		echo "// openssl not found!"
 		echo "const char *config_mak = \"CFG: openssl not found in PATH!\";"
 	else
-		echo "// This file is generated by ./config.sh --objdir $OBJDIR --make-config.mak"
+		# Deliberately no $OBJDIR here: it is an absolute build path and
+		# this comment is shipped in the debug sources.
+		echo "// This file is generated by ./config.sh --make-config.mak"
 		echo "const char *config_mak ="
 		printf "  \"\\\nCFG: strings FILE | sed -n 's/^CFG~//p' | openssl enc -d -base64 | gzip -d\\\n\"\n"
 		gzip -9 < $OBJDIR/config.mak | $OPENSSL enc -base64 | while read LINE
