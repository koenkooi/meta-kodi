+// Generated by meson (see meson.build) -- plain-text build configuration,
+// kept in the binary via the config_mak symbol (see oscam.c) purely so it
+// can still be read back with:
+//   strings <binary> | grep '^CFG:'
+const char *config_mak =
+@CONFIG_MAK_BODY@
+  ;
