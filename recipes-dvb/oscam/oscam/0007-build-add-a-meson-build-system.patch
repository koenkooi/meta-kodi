From 04a5f3a75d80f8b1db180cd8e87cd65305ec6325 Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Fri, 7 Aug 2026 21:27:22 +0200
Subject: [PATCH 07/10] build: add a meson build system

Same conversion already done on the old r11273-based checkout, ported
to this Toysoft-mirror base: config.h/config.c/webif/is_defined.txt
generated directly from meson options (meson_options.txt, config.h.in)
instead of shelling out to config.sh, config.h in the source tree left
untouched for the Makefile/CMake/config.sh path.

Three real source-selection differences versus the old base, found by
diffing this Makefile against the old one rather than assuming nothing
changed: MODULE_GBOX gained module-gbox-remm.c, READER_NAGRA now needs
reader-nagra-common.c (a real link dependency, reader-nagra.c includes
its header), and WITH_COOLAPI/WITH_COOLAPI2/WITH_SU980 swapped which
of module-dvbapi-coolapi.c / module-dvbapi-coolapi-legacy.c they
select. Also broadened LIB_DES condition (READER_NAGRA/VIDEOGUARD/
CONAX now need it too, matching this Makefile list_config -- inert for
our default config since READER_DRE already forces it on, fixed for
correctness anyway).

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>
Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Upstream-Status: Inappropriate [oe-specific meson build, no upstream equivalent]
---
 config.h.in             |  64 +++++
 meson.build             | 518 ++++++++++++++++++++++++++++++++++++++++
 meson/config.c.in       |   7 +
 meson_options.txt       |  91 +++++++
 webif/is_defined.txt.in |   1 +
 webif/meson.build       |  25 ++
 6 files changed, 706 insertions(+)
 create mode 100644 config.h.in
 create mode 100644 meson.build
 create mode 100644 meson/config.c.in
 create mode 100644 meson_options.txt
 create mode 100644 webif/is_defined.txt.in
 create mode 100644 webif/meson.build

diff --git a/config.h.in b/config.h.in
new file mode 100644
index 0000000..41bef71
--- /dev/null
+++ b/config.h.in
@@ -0,0 +1,64 @@
+// Generated by meson from config.h.in -- see meson.build/meson_options.txt.
+// config.h (source tree) is the config.sh/Makefile/CMake version; this is
+// the meson build's own copy, generated into the build directory where it
+// shadows the source one for anything built via meson.
+//
+// Plain @VAR@ substitution, not #mesondefine: globals.h's config_enabled()
+// does a Linux-kernel-style token paste (__ARG_PLACEHOLDER_##value) that
+// needs the *literal value* "1" on the enabled line, not just definedness --
+// #mesondefine's bool handling only ever emits a bare "#define NAME" (no
+// value) or "#undef NAME", which breaks that trick. meson.build builds
+// TOP_LEVEL_DEFINES/CARDREADER_DEFINES as literal "#define NAME 1" /
+// "#undef NAME" text instead.
+#ifndef CONFIG_H_
+#define CONFIG_H_
+
+@TOP_LEVEL_DEFINES@
+// Derived, not independently settable -- true whenever any reader or card
+// reader below is enabled. See the with_cardreader computation in
+// meson.build (mirrors config.sh's update_deps()).
+@WITH_CARDREADER_DEFINE@
+
+#ifdef WITH_CARDREADER
+
+@CARDREADER_DEFINES@
+
+// Below: derived purely from the WITH_xxx compiler defines meson.build
+// already passes via c_args (-DWITH_PCSC=1 etc, see the external-libraries
+// section) -- not meson options, unchanged from the original config.h.
+
+#ifdef WITH_PCSC
+#define CARDREADER_PCSC 1
+#endif
+
+#ifdef WITH_LIBUSB
+#define CARDREADER_SMART 1
+#endif
+
+// CARDREADER_INTERNAL_{AZBOX,COOLAPI,SCI} are internal variables
+// do not touch them
+#if (defined(CARDREADER_INTERNAL) && defined(WITH_AZBOX))
+#define CARDREADER_INTERNAL_AZBOX 1
+#elif (defined(CARDREADER_INTERNAL) && (defined(WITH_COOLAPI) || defined(WITH_SU980)))
+#define CARDREADER_INTERNAL_COOLAPI 1
+#elif defined(CARDREADER_INTERNAL) && defined(WITH_COOLAPI2)
+#define CARDREADER_INTERNAL_COOLAPI2 1
+#elif defined(CARDREADER_INTERNAL)
+#define CARDREADER_INTERNAL_SCI 1
+#endif
+
+#ifdef WITH_STAPI
+#define CARDREADER_STAPI 1
+#endif
+
+#ifdef WITH_STAPI5
+#define CARDREADER_STAPI5 1
+#endif
+
+#ifdef READER_DRE
+#define READER_DRECAS 1
+#endif
+
+#endif // WITH_CARDREADER
+
+#endif //OSCAM_CONFIG_H_
diff --git a/meson.build b/meson.build
new file mode 100644
index 0000000..0544d68
--- /dev/null
+++ b/meson.build
@@ -0,0 +1,518 @@
+project('oscam', 'c',
+  version: '1.20',
+  license: 'GPL-3.0-or-later',
+  meson_version: '>= 0.59.0',
+  default_options: ['c_std=gnu99', 'warning_level=1'])
+
+# The full reader/protocol/addon feature matrix is real meson options (see
+# meson_options.txt) -- config.h is generated straight from them via
+# config.h.in, no more shelling out to config.sh at configure time.
+# config.h in the source tree is left alone; it still drives the legacy
+# Makefile/CMake/config.sh path for anyone still using those directly.
+
+cc = meson.get_compiler('c')
+srcdir = meson.current_source_dir()
+
+not_found = dependency('', required: false)
+
+#----------------------- external libraries -> USE_xxx flags ------------------
+
+# The Makefile forces USE_SSL/USE_LIBCRYPTO on whenever config.h's own
+# WITH_SSL toggle is enabled -- with-ssl is that same toggle here.
+with_ssl_opt = get_option('with-ssl')
+
+ssl_opt = get_option('ssl')
+if ssl_opt.disabled()
+  libssl_dep = not_found
+elif with_ssl_opt or ssl_opt.enabled()
+  libssl_dep = dependency('libssl', required: true)
+else
+  libssl_dep = dependency('libssl', required: false)
+endif
+
+# WITH_SSL implies libcrypto, same as the Makefile does.
+libcrypto_opt = get_option('libcrypto')
+if libcrypto_opt.disabled()
+  if libssl_dep.found()
+    error('-Dssl requires libcrypto, do not disable it')
+  endif
+  libcrypto_dep = not_found
+elif libssl_dep.found() or libcrypto_opt.enabled()
+  libcrypto_dep = dependency('libcrypto', required: true)
+else
+  libcrypto_dep = dependency('libcrypto', required: false)
+endif
+
+libusb_dep = dependency('libusb-1.0', required: get_option('libusb'))
+pcsc_dep = dependency('libpcsclite', required: get_option('pcsc'))
+
+use_flags = []
+oscam_args = []
+oscam_deps = []
+
+if libcrypto_dep.found()
+  use_flags += 'USE_LIBCRYPTO'
+  oscam_args += '-DWITH_LIBCRYPTO=1'
+  oscam_deps += libcrypto_dep
+endif
+if libssl_dep.found()
+  use_flags += 'USE_SSL'
+  oscam_args += '-DWITH_SSL=1'
+  oscam_deps += libssl_dep
+endif
+if libusb_dep.found()
+  use_flags += 'USE_LIBUSB'
+  oscam_args += '-DWITH_LIBUSB=1'
+  oscam_deps += libusb_dep
+  # csctapi/ifd_smartreader.c includes <libusb-1.0/libusb.h>, but the
+  # pkg-config cflags point inside that directory, so add its parent too.
+  libusb_incdir = libusb_dep.get_variable(pkgconfig: 'includedir', default_value: '')
+  if libusb_incdir != ''
+    oscam_args += '-I' + libusb_incdir
+  endif
+endif
+if pcsc_dep.found()
+  use_flags += 'USE_PCSC'
+  oscam_args += '-DWITH_PCSC=1'
+  oscam_deps += pcsc_dep
+  # Same story as libusb: csctapi/ifd_pcsc.c includes <PCSC/pcsclite.h>
+  # while the pkg-config cflags point at the PCSC directory itself.
+  pcsc_incdir = pcsc_dep.get_variable(pkgconfig: 'includedir', default_value: '')
+  if pcsc_incdir != ''
+    oscam_args += '-I' + pcsc_incdir
+  endif
+endif
+if get_option('utf8')
+  oscam_args += '-DWITH_UTF8'
+endif
+
+# Vendor SDKs. They ship no pkg-config file and no headers we can probe for,
+# so they stay plain booleans exactly like the Makefile USE_xxx variables.
+foreach sdk : [['stapi', 'STAPI'], ['stapi5', 'STAPI5'], ['coolapi', 'COOLAPI'],
+               ['coolapi2', 'COOLAPI2'], ['su980', 'SU980'], ['azbox', 'AZBOX'],
+               ['mca', 'MCA']]
+  if get_option(sdk[0])
+    use_flags += 'USE_' + sdk[1]
+    oscam_args += '-DWITH_' + sdk[1] + '=1'
+  endif
+endforeach
+
+#----------------------- config.h feature matrix -------------------------------
+
+# name -> option() key, grouped exactly like config.sh's addons/protocols/
+# readers/card_readers, in config.h's own order.
+addon_opts = [
+  ['WEBIF', 'webif'], ['WEBIF_LIVELOG', 'webif-livelog'],
+  ['WEBIF_JQUERY', 'webif-jquery'], ['TOUCH', 'touch'],
+  ['WITH_SSL', 'with-ssl'], ['HAVE_DVBAPI', 'have-dvbapi'],
+  ['READ_SDT_CHARSETS', 'read-sdt-charsets'], ['CLOCKFIX', 'clockfix'],
+  ['IRDETO_GUESSING', 'irdeto-guessing'], ['CS_ANTICASC', 'cs-anticasc'],
+  ['WITH_DEBUG', 'with-debug'], ['WITH_LB', 'with-lb'],
+  ['CS_CACHEEX', 'cs-cacheex'], ['CW_CYCLE_CHECK', 'cw-cycle-check'],
+  ['LCDSUPPORT', 'lcdsupport'], ['LEDSUPPORT', 'ledsupport'],
+  ['IPV6SUPPORT', 'ipv6support'], ['MODULE_MONITOR', 'module-monitor'],
+]
+protocol_opts = [
+  ['MODULE_CAMD33', 'module-camd33'], ['MODULE_CAMD35', 'module-camd35'],
+  ['MODULE_CAMD35_TCP', 'module-camd35-tcp'], ['MODULE_NEWCAMD', 'module-newcamd'],
+  ['MODULE_CCCAM', 'module-cccam'], ['MODULE_CCCSHARE', 'module-cccshare'],
+  ['MODULE_GBOX', 'module-gbox'], ['MODULE_RADEGAST', 'module-radegast'],
+  ['MODULE_SERIAL', 'module-serial'], ['MODULE_CONSTCW', 'module-constcw'],
+  ['MODULE_PANDORA', 'module-pandora'], ['MODULE_GHTTP', 'module-ghttp'],
+  ['MODULE_SCAM', 'module-scam'],
+]
+reader_opts = [
+  ['READER_NAGRA', 'reader-nagra'], ['READER_IRDETO', 'reader-irdeto'],
+  ['READER_CONAX', 'reader-conax'], ['READER_CRYPTOWORKS', 'reader-cryptoworks'],
+  ['READER_SECA', 'reader-seca'], ['READER_VIACCESS', 'reader-viaccess'],
+  ['READER_VIDEOGUARD', 'reader-videoguard'], ['READER_DRE', 'reader-dre'],
+  ['READER_TONGFANG', 'reader-tongfang'], ['READER_BULCRYPT', 'reader-bulcrypt'],
+  ['READER_GRIFFIN', 'reader-griffin'], ['READER_DGCRYPT', 'reader-dgcrypt'],
+]
+cardreader_opts = [
+  ['CARDREADER_PHOENIX', 'cardreader-phoenix'], ['CARDREADER_INTERNAL', 'cardreader-internal'],
+  ['CARDREADER_MP35', 'cardreader-mp35'], ['CARDREADER_SC8IN1', 'cardreader-sc8in1'],
+  ['CARDREADER_SMARGO', 'cardreader-smargo'], ['CARDREADER_DB2COM', 'cardreader-db2com'],
+  ['CARDREADER_STINGER', 'cardreader-stinger'], ['CARDREADER_DRECAS', 'cardreader-drecas'],
+]
+
+conf = {}
+foreach group : [addon_opts, protocol_opts, reader_opts, cardreader_opts]
+  foreach pair : group
+    conf += {pair[0]: get_option(pair[1])}
+  endforeach
+endforeach
+
+# WITH_CARDREADER is derived, not independently settable: on whenever any
+# reader or card reader is enabled (mirrors config.sh's update_deps()).
+with_cardreader = false
+foreach pair : reader_opts + cardreader_opts
+  if conf[pair[0]]
+    with_cardreader = true
+  endif
+endforeach
+conf += {'WITH_CARDREADER': with_cardreader}
+
+# Plain "#define NAME 1" / "#undef NAME" text, not #mesondefine -- see the
+# comment in config.h.in for why (globals.h's config_enabled() needs the
+# literal value "1", not just definedness).
+top_level_lines = []
+foreach pair : addon_opts + protocol_opts
+  d = conf[pair[0]] ? '#define ' + pair[0] + ' 1' : '#undef ' + pair[0]
+  if pair[0] == 'HAVE_DVBAPI'
+    # Matches the original config.h: only ever defined on a platform that
+    # actually has a DVB API, regardless of the option's own value.
+    d = '#if defined(__linux__) || defined(__CYGWIN__)\n' + d + '\n#endif'
+  endif
+  top_level_lines += d
+endforeach
+
+cardreader_lines = []
+foreach pair : reader_opts + cardreader_opts
+  cardreader_lines += conf[pair[0]] ? '#define ' + pair[0] + ' 1' : '#undef ' + pair[0]
+endforeach
+
+config_h_cdata = configuration_data()
+config_h_cdata.set('TOP_LEVEL_DEFINES', '\n'.join(top_level_lines))
+config_h_cdata.set('WITH_CARDREADER_DEFINE',
+                   with_cardreader ? '#define WITH_CARDREADER 1' : '#undef WITH_CARDREADER')
+config_h_cdata.set('CARDREADER_DEFINES', '\n'.join(cardreader_lines))
+configure_file(input: 'config.h.in', output: 'config.h', configuration: config_h_cdata)
+
+# LIB_xxx: the bundled crypto/compression code needed once libcrypto isn't
+# doing the job, or a specific protocol/reader needs it. Mirrors config.sh's
+# list_config() exactly (the only place this logic lived before).
+lib_bignum = not libcrypto_dep.found() and (conf['READER_CONAX'] or conf['READER_CRYPTOWORKS'] or conf['READER_NAGRA'])
+lib_aes    = not libcrypto_dep.found()
+lib_des    = conf['READER_DRE'] or conf['MODULE_SCAM'] or conf['READER_VIACCESS'] or conf['READER_NAGRA'] or conf['READER_VIDEOGUARD'] or conf['READER_CONAX']
+lib_idea   = conf['MODULE_CCCAM'] or conf['READER_NAGRA'] or conf['READER_SECA']
+lib_rc6    = conf['MODULE_CCCAM']
+lib_sha1   = not libcrypto_dep.found() and conf['MODULE_CCCAM']
+lib_minilzo = conf['MODULE_GBOX'] or conf['WEBIF']
+
+#----------------------- sources ----------------------------------------------
+
+# Mirrors the SRC-y / SRC-$(CONFIG_xxx) table in the Makefile.
+srcs = files(
+  'cscrypt/md5.c',
+  'oscam-aes.c',
+  'oscam-array.c',
+  'oscam-hashtable.c',
+  'oscam-cache.c',
+  'oscam-chk.c',
+  'oscam-client.c',
+  'oscam-conf.c',
+  'oscam-conf-chk.c',
+  'oscam-conf-mk.c',
+  'oscam-config-account.c',
+  'oscam-config-global.c',
+  'oscam-config-reader.c',
+  'oscam-config.c',
+  'oscam-ecm.c',
+  'oscam-emm.c',
+  'oscam-emm-cache.c',
+  'oscam-failban.c',
+  'oscam-files.c',
+  'oscam-garbage.c',
+  'oscam-lock.c',
+  'oscam-log.c',
+  'oscam-log-reader.c',
+  'oscam-net.c',
+  'oscam-llist.c',
+  'oscam-reader.c',
+  'oscam-simples.c',
+  'oscam-string.c',
+  'oscam-time.c',
+  'oscam-work.c',
+  'oscam.c',
+)
+
+if lib_aes
+  srcs += files('cscrypt/aes.c')
+endif
+if lib_bignum
+  srcs += files('cscrypt/bn_add.c', 'cscrypt/bn_asm.c', 'cscrypt/bn_ctx.c',
+                'cscrypt/bn_div.c', 'cscrypt/bn_exp.c', 'cscrypt/bn_lib.c',
+                'cscrypt/bn_mul.c', 'cscrypt/bn_print.c', 'cscrypt/bn_shift.c',
+                'cscrypt/bn_sqr.c', 'cscrypt/bn_word.c', 'cscrypt/mem.c')
+endif
+if lib_des
+  srcs += files('cscrypt/des.c')
+endif
+if lib_idea
+  srcs += files('cscrypt/i_cbc.c', 'cscrypt/i_ecb.c', 'cscrypt/i_skey.c')
+endif
+if lib_rc6
+  srcs += files('cscrypt/rc6.c')
+endif
+if lib_sha1
+  srcs += files('cscrypt/sha1.c')
+endif
+if lib_minilzo
+  srcs += files('minilzo/minilzo.c')
+endif
+
+conditional_srcs = {
+  'WITH_CARDREADER'          : ['csctapi/atr.c', 'csctapi/icc_async.c',
+                                'csctapi/io_serial.c', 'csctapi/protocol_t0.c',
+                                'csctapi/protocol_t1.c', 'reader-common.c'],
+  'CARDREADER_DB2COM'        : ['csctapi/ifd_db2com.c'],
+  'CARDREADER_MP35'          : ['csctapi/ifd_mp35.c'],
+  'CARDREADER_PHOENIX'       : ['csctapi/ifd_phoenix.c'],
+  'CARDREADER_DRECAS'        : ['csctapi/ifd_drecas.c'],
+  'CARDREADER_SC8IN1'        : ['csctapi/ifd_sc8in1.c'],
+  'CARDREADER_SMARGO'        : ['csctapi/ifd_smargo.c'],
+  'CARDREADER_STINGER'       : ['csctapi/ifd_stinger.c'],
+  'CS_ANTICASC'              : ['module-anticasc.c'],
+  'CS_CACHEEX'               : ['module-cacheex.c', 'module-camd35-cacheex.c',
+                                'module-cccam-cacheex.c', 'module-csp.c'],
+  'MODULE_CAMD33'            : ['module-camd33.c'],
+  'MODULE_CCCAM'             : ['module-cccam.c'],
+  'MODULE_CCCSHARE'          : ['module-cccshare.c'],
+  'MODULE_CONSTCW'           : ['module-constcw.c'],
+  'CW_CYCLE_CHECK'           : ['module-cw-cycle-check.c'],
+  'HAVE_DVBAPI'              : ['module-dvbapi-chancache.c', 'module-dvbapi.c'],
+  'MODULE_GBOX'               : ['module-gbox-helper.c', 'module-gbox-sms.c',
+                                'module-gbox-cards.c', 'module-gbox.c',
+                                'module-gbox-remm.c'],
+  'IRDETO_GUESSING'          : ['module-ird-guess.c'],
+  'LCDSUPPORT'               : ['module-lcd.c'],
+  'LEDSUPPORT'               : ['module-led.c'],
+  'MODULE_MONITOR'           : ['module-monitor.c'],
+  'MODULE_NEWCAMD'           : ['module-newcamd.c', 'module-newcamd-des.c'],
+  'MODULE_PANDORA'           : ['module-pandora.c'],
+  'MODULE_GHTTP'             : ['module-ghttp.c'],
+  'MODULE_RADEGAST'          : ['module-radegast.c'],
+  'MODULE_SCAM'              : ['module-scam.c'],
+  'MODULE_SERIAL'            : ['module-serial.c'],
+  'WITH_LB'                  : ['module-stat.c'],
+  'WEBIF'                    : ['module-webif-lib.c', 'module-webif-tpl.c',
+                                'module-webif.c'],
+  'READER_BULCRYPT'          : ['reader-bulcrypt.c'],
+  'READER_CONAX'             : ['reader-conax.c'],
+  'READER_CRYPTOWORKS'       : ['reader-cryptoworks.c'],
+  'READER_DGCRYPT'           : ['reader-dgcrypt.c'],
+  'READER_DRE'                : ['reader-dre.c', 'reader-dre-cas.c',
+                                'reader-dre-common.c', 'reader-dre-st20.c'],
+  'READER_GRIFFIN'           : ['reader-griffin.c'],
+  'READER_IRDETO'            : ['reader-irdeto.c'],
+  'READER_NAGRA'             : ['reader-nagra.c', 'reader-nagra-common.c'],
+  'READER_SECA'              : ['reader-seca.c'],
+  'READER_TONGFANG'          : ['reader-tongfang.c'],
+  'READER_VIACCESS'          : ['reader-viaccess.c'],
+  'READER_VIDEOGUARD'        : ['reader-videoguard-common.c',
+                                'reader-videoguard1.c', 'reader-videoguard12.c',
+                                'reader-videoguard2.c'],
+}
+
+foreach key, sources : conditional_srcs
+  if conf.get(key, false)
+    srcs += files(sources)
+  endif
+endforeach
+
+# Sources selected by more than one config symbol, kept out of the dict above
+# so they can never be added twice.
+if conf['MODULE_CAMD35'] or conf['MODULE_CAMD35_TCP']
+  srcs += files('module-camd35.c')
+endif
+# WITH_COOLAPI alone uses the legacy implementation; WITH_COOLAPI2 and
+# WITH_SU980 share the current one (matches the Makefile SRC-y table --
+# this split changed upstream since this project first packaged it).
+if get_option('coolapi')
+  srcs += files('module-dvbapi-coolapi-legacy.c')
+endif
+if get_option('coolapi2') or get_option('su980')
+  srcs += files('module-dvbapi-coolapi.c')
+endif
+if get_option('azbox')
+  srcs += files('module-dvbapi-azbox.c')
+endif
+if get_option('mca')
+  srcs += files('module-dvbapi-mca.c')
+endif
+if get_option('stapi')
+  srcs += files('module-dvbapi-stapi.c')
+endif
+if get_option('stapi5')
+  srcs += files('module-dvbapi-stapi5.c')
+endif
+# The rest mirror config.h's CARDREADER_xxx derivation exactly (see
+# config.h.in) -- CARDREADER_PCSC/SMART/STAPI/STAPI5 are independent
+# top-level derivations (just gated on the matching WITH_xxx), while
+# CARDREADER_INTERNAL_{AZBOX,COOLAPI,COOLAPI2,SCI} are an exclusive chain
+# under CARDREADER_INTERNAL, AZBOX first, then COOLAPI (WITH_COOLAPI or
+# WITH_SU980), then COOLAPI2, else SCI as the fallback.
+if pcsc_dep.found()
+  srcs += files('csctapi/ifd_pcsc.c')
+endif
+if libusb_dep.found()
+  srcs += files('csctapi/ifd_smartreader.c')
+endif
+if get_option('stapi') or get_option('stapi5')
+  srcs += files('csctapi/ifd_stapi.c')
+endif
+if conf['CARDREADER_INTERNAL'] and get_option('azbox')
+  srcs += files('csctapi/ifd_azbox.c')
+elif conf['CARDREADER_INTERNAL'] and (get_option('coolapi') or get_option('su980') or get_option('coolapi2'))
+  srcs += files('csctapi/ifd_cool.c')
+elif conf['CARDREADER_INTERNAL']
+  srcs += files('csctapi/ifd_sci.c')
+endif
+
+#----------------------- config.c (embedded build info, cosmetic only) --------
+
+# oscam --build-info gets its text straight from write_conf()/config_enabled()
+# calls at runtime -- this is a SEPARATE, purely cosmetic mechanism: a plain
+# text dump of every CONFIG_/USE_ flag kept in the binary via the config_mak
+# symbol (see oscam.c) so it can be read back with:
+#   strings <binary> | grep '^CFG:'
+# The old config.sh version gzip+base64-encoded this text; not reproduced
+# here since nothing decodes it automatically either way -- plain text is
+# just as inspectable and needs no openssl/gzip at build time.
+config_mak_lines = []
+foreach group : [addon_opts, protocol_opts, reader_opts, cardreader_opts]
+  foreach pair : group
+    tag = conf[pair[0]] ? 'y' : 'n'
+    config_mak_lines += '  "CFG:CONFIG_' + pair[0] + '=' + tag + '\\n"'
+  endforeach
+endforeach
+config_mak_lines += '  "CFG:CONFIG_WITH_CARDREADER=' + (with_cardreader ? 'y' : 'n') + '\\n"'
+foreach lib : [['LIB_AES', lib_aes], ['LIB_BIGNUM', lib_bignum], ['LIB_DES', lib_des],
+               ['LIB_IDEA', lib_idea], ['LIB_RC6', lib_rc6], ['LIB_SHA1', lib_sha1],
+               ['LIB_MINILZO', lib_minilzo]]
+  config_mak_lines += '  "CFG:CONFIG_' + lib[0] + '=' + (lib[1] ? 'y' : 'n') + '\\n"'
+endforeach
+foreach flag : use_flags
+  config_mak_lines += '  "CFG:CONFIG_' + flag + '=y\\n"'
+endforeach
+
+config_c_cdata = configuration_data()
+config_c_cdata.set('CONFIG_MAK_BODY', '\n'.join(config_mak_lines))
+config_c = configure_file(input: 'meson/config.c.in', output: 'config.c',
+                          configuration: config_c_cdata)
+srcs += config_c
+
+#----------------------- webif -------------------------------------------------
+
+if conf['WEBIF']
+  # is_defined.txt: one enabled macro name per line, read by pages_gen to
+  # filter templates -- mirrors config.sh's write_enabled() (addons +
+  # protocols + readers + card_readers + WITH_CARDREADER, never the LIB_xxx
+  # pseudo-flags, those never appeared in the old file either).
+  is_defined_names = []
+  foreach group : [addon_opts, protocol_opts, reader_opts, cardreader_opts]
+    foreach pair : group
+      if conf[pair[0]]
+        is_defined_names += pair[0]
+      endif
+    endforeach
+  endforeach
+  if with_cardreader
+    is_defined_names += 'WITH_CARDREADER'
+  endif
+  is_defined_content = '\n'.join(is_defined_names) + '\n'
+
+  subdir('webif')
+  srcs += webif_pages
+endif
+
+#----------------------- flags ------------------------------------------------
+
+confdir = get_option('confdir')
+if confdir == ''
+  confdir = get_option('prefix') / get_option('sysconfdir')
+endif
+
+svn_revision = get_option('svn-revision')
+if svn_revision == ''
+  # No svn metadata in a git checkout; config.sh's own fallback was the same
+  # constant once svnversion failed.
+  svn_revision = '0'
+endif
+
+oscam_args += [
+  '-DCS_CONFDIR="' + confdir + '"',
+  '-DCS_SVN_VERSION="' + svn_revision + '"',
+  '-DCS_TARGET="' + host_machine.cpu_family() + '-' + host_machine.system() + '"',
+]
+
+oscam_args += cc.get_supported_arguments([
+  '-Wshadow',
+  '-Wredundant-decls',
+  '-Wstrict-prototypes',
+  '-Wold-style-definition',
+  '-ffunction-sections',
+  '-fdata-sections',
+])
+
+oscam_link_args = cc.get_supported_link_arguments(['-Wl,--gc-sections'])
+
+oscam_deps += dependency('threads')
+
+dl_dep = cc.find_library('dl', required: false)
+if dl_dep.found()
+  oscam_deps += dl_dep
+endif
+
+# librt is only pulled in for the CLOCKFIX clock_gettime() use, and only on
+# platforms where it is a separate library.
+if conf['CLOCKFIX']
+  rt_dep = cc.find_library('rt', required: false)
+  if rt_dep.found()
+    oscam_deps += rt_dep
+  endif
+endif
+
+inc = include_directories('.', 'csctapi', 'cscrypt', 'minilzo', 'webif')
+
+#----------------------- the executable ---------------------------------------
+
+executable('oscam',
+  srcs,
+  include_directories: inc,
+  c_args: oscam_args,
+  link_args: oscam_link_args,
+  dependencies: oscam_deps,
+  install: true)
+
+#----------------------- installation -----------------------------------------
+
+install_data(
+  files('Distribution/doc/example/oscam.ac',
+        'Distribution/doc/example/oscam.cert',
+        'Distribution/doc/example/oscam.conf',
+        'Distribution/doc/example/oscam.guess',
+        'Distribution/doc/example/oscam.ird',
+        'Distribution/doc/example/oscam.server',
+        'Distribution/doc/example/oscam.services',
+        'Distribution/doc/example/oscam.srvid',
+        'Distribution/doc/example/oscam.user'),
+  install_dir: get_option('datadir') / 'doc' / 'oscam' / 'example')
+
+install_man(
+  'Distribution/doc/man/oscam.1',
+  'Distribution/doc/man/oscam.ac.5',
+  'Distribution/doc/man/oscam.cacheex.5',
+  'Distribution/doc/man/oscam.cert.5',
+  'Distribution/doc/man/oscam.conf.5',
+  'Distribution/doc/man/oscam.dvbapi.5',
+  'Distribution/doc/man/oscam.guess.5',
+  'Distribution/doc/man/oscam.ird.5',
+  'Distribution/doc/man/oscam.provid.5',
+  'Distribution/doc/man/oscam.ratelimit.5',
+  'Distribution/doc/man/oscam.server.5',
+  'Distribution/doc/man/oscam.services.5',
+  'Distribution/doc/man/oscam.srvid.5',
+  'Distribution/doc/man/oscam.srvid2.5',
+  'Distribution/doc/man/oscam.tiers.5',
+  'Distribution/doc/man/oscam.user.5',
+  'Distribution/doc/man/oscam.whitelist.5')
+
+summary({
+  'config dir': confdir,
+  'svn revision': svn_revision,
+  'use flags': ' '.join(use_flags) == '' ? '(none)' : ' '.join(use_flags),
+  'enabled config': conf.keys().length(),
+  'sources': srcs.length(),
+}, section: 'OSCam')
