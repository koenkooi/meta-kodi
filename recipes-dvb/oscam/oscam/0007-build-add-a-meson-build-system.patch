@@ -0,0 +1,91 @@
+# The full reader/protocol/addon feature matrix (config.h in the old
+# config.sh/Makefile/CMake build) is real meson options here -- no shelling
+# out to config.sh at configure time. Defaults match config.sh's own
+# defconfig. Toggle any of these the normal meson way, e.g.:
+#   meson configure build -Dreader-nagra=false -Dmodule-gbox=false
+
+# External libraries / vendor SDKs (the old USE_xxx flags)
+option('libcrypto', type: 'feature', value: 'auto',
+       description: 'Use OpenSSL libcrypto instead of the bundled crypto code')
+option('ssl', type: 'feature', value: 'auto',
+       description: 'Build the webif with OpenSSL (implies libcrypto)')
+option('libusb', type: 'feature', value: 'auto',
+       description: 'Smartreader support via libusb-1.0')
+option('pcsc', type: 'feature', value: 'auto',
+       description: 'PC/SC card reader support')
+option('utf8', type: 'boolean', value: false,
+       description: 'UTF-8 enabled webif by default')
+
+option('stapi', type: 'boolean', value: false, description: 'STAPI vendor SDK')
+option('stapi5', type: 'boolean', value: false, description: 'STAPI5 vendor SDK')
+option('coolapi', type: 'boolean', value: false, description: 'Coolstream COOLAPI')
+option('coolapi2', type: 'boolean', value: false, description: 'Coolstream COOLAPI2')
+option('su980', type: 'boolean', value: false, description: 'SU980 vendor SDK')
+option('azbox', type: 'boolean', value: false, description: 'AZBox OpenXCAS')
+option('mca', type: 'boolean', value: false, description: 'Matrix Cam Air')
+
+option('confdir', type: 'string', value: '',
+       description: 'Default config directory (empty: prefix/sysconfdir)')
+option('svn-revision', type: 'string', value: '',
+       description: 'Value for CS_SVN_VERSION (empty: 0, no svn metadata in a git checkout)')
+
+# Addons
+option('webif', type: 'boolean', value: true, description: 'Web interface')
+option('webif-livelog', type: 'boolean', value: true, description: 'Web interface live log (needs webif)')
+option('webif-jquery', type: 'boolean', value: true, description: 'Web interface jQuery support (needs webif)')
+option('touch', type: 'boolean', value: true, description: 'Touch-friendly web interface')
+option('with-ssl', type: 'boolean', value: false,
+       description: 'SSL support (WITH_SSL) -- forces the ssl/libcrypto deps required when true')
+option('have-dvbapi', type: 'boolean', value: true, description: 'DVB API support (Linux/Cygwin only)')
+option('read-sdt-charsets', type: 'boolean', value: true, description: 'DVB API read-SDT charsets')
+option('irdeto-guessing', type: 'boolean', value: true, description: 'Irdeto guessing')
+option('cs-anticasc', type: 'boolean', value: true, description: 'Anti-cascading support')
+option('with-debug', type: 'boolean', value: true, description: 'Debug mode')
+option('module-monitor', type: 'boolean', value: true, description: 'Monitor protocol')
+option('with-lb', type: 'boolean', value: true, description: 'Loadbalancing support')
+option('cs-cacheex', type: 'boolean', value: true, description: 'Cache exchange support')
+option('cw-cycle-check', type: 'boolean', value: true, description: 'CW Cycle Check support')
+option('lcdsupport', type: 'boolean', value: false, description: 'LCD support')
+option('ledsupport', type: 'boolean', value: false, description: 'LED support')
+option('clockfix', type: 'boolean', value: true, description: 'Clock fix')
+option('ipv6support', type: 'boolean', value: false, description: 'IPv6 support')
+
+# Protocols
+option('module-camd33', type: 'boolean', value: false, description: 'camd 3.3x protocol')
+option('module-camd35', type: 'boolean', value: true, description: 'camd 3.5 UDP protocol')
+option('module-camd35-tcp', type: 'boolean', value: true, description: 'camd 3.5 TCP protocol')
+option('module-newcamd', type: 'boolean', value: true, description: 'newcamd protocol')
+option('module-cccam', type: 'boolean', value: true, description: 'CCcam protocol')
+option('module-cccshare', type: 'boolean', value: true, description: 'CCcam share (needs module-cccam)')
+option('module-gbox', type: 'boolean', value: true, description: 'gbox protocol')
+option('module-radegast', type: 'boolean', value: true, description: 'radegast protocol')
+option('module-serial', type: 'boolean', value: true, description: 'serial protocol')
+option('module-constcw', type: 'boolean', value: true, description: 'constant CW protocol')
+option('module-pandora', type: 'boolean', value: true, description: 'pandora protocol')
+option('module-ghttp', type: 'boolean', value: true, description: 'ghttp protocol')
+option('module-scam', type: 'boolean', value: true, description: 'scam protocol')
+
+# Readers
+option('reader-nagra', type: 'boolean', value: true, description: 'Nagra reader')
+option('reader-irdeto', type: 'boolean', value: true, description: 'Irdeto reader')
+option('reader-conax', type: 'boolean', value: true, description: 'Conax reader')
+option('reader-cryptoworks', type: 'boolean', value: true, description: 'Cryptoworks reader')
+option('reader-seca', type: 'boolean', value: true, description: 'Seca reader')
+option('reader-viaccess', type: 'boolean', value: true, description: 'Viaccess reader')
+option('reader-videoguard', type: 'boolean', value: true, description: 'Videoguard reader')
+option('reader-dre', type: 'boolean', value: true, description: 'DRE reader')
+option('reader-tongfang', type: 'boolean', value: true, description: 'Tongfang reader')
+option('reader-bulcrypt', type: 'boolean', value: true, description: 'Bulcrypt reader')
+option('reader-griffin', type: 'boolean', value: true, description: 'Griffin reader')
+option('reader-dgcrypt', type: 'boolean', value: true, description: 'DGCrypt reader')
+
+# Card readers (only meaningful when at least one reader above is enabled --
+# WITH_CARDREADER is derived from that, see meson.build)
+option('cardreader-phoenix', type: 'boolean', value: true, description: 'Phoenix card reader')
+option('cardreader-internal', type: 'boolean', value: true, description: 'Internal card reader')
+option('cardreader-mp35', type: 'boolean', value: true, description: 'MP35 card reader')
+option('cardreader-sc8in1', type: 'boolean', value: true, description: 'SC8in1 card reader')
+option('cardreader-smargo', type: 'boolean', value: true, description: 'Smargo card reader')
+option('cardreader-db2com', type: 'boolean', value: true, description: 'DB2COM card reader')
+option('cardreader-stinger', type: 'boolean', value: true, description: 'Stinger card reader')
+option('cardreader-drecas', type: 'boolean', value: true, description: 'DRECAS card reader')
