diff --git a/webif/meson.build b/webif/meson.build
new file mode 100644
index 0000000..57e2f60
--- /dev/null
+++ b/webif/meson.build
@@ -0,0 +1,25 @@
+# is_defined.txt: which macros pages_gen should treat as enabled when
+# filtering templates (see the parent meson.build for is_defined_content).
+# Generated at configure time, into this subdir's own build directory --
+# pages_gen is told to look there too (see the custom_target below), so
+# nothing needs to land in the source tree.
+is_defined_cdata = configuration_data()
+is_defined_cdata.set('CONTENT', is_defined_content)
+configure_file(input: 'is_defined.txt.in', output: 'is_defined.txt',
+               configuration: is_defined_cdata)
+
+# pages_gen turns the webif/ template tree into a C source. It runs on the
+# build machine, so it is a native executable even when cross compiling; the
+# Makefile does the same with HOSTCC.
+pages_gen = executable('pages_gen',
+  ['pages_gen.c', '../minilzo/minilzo.c'],
+  native: true,
+  build_by_default: false)
+
+# pages_gen reads its inputs relative to the first argument and writes
+# pages.c/pages.h into the second, so nothing lands in the source tree.
+webif_pages = custom_target('webif-pages',
+  output: ['pages.c', 'pages.h'],
+  command: [pages_gen, meson.current_source_dir(), meson.current_build_dir()],
+  depend_files: files('pages_index.txt'),
+  build_by_default: true)
