From: Koen Kooi <koen@dominion.thruhere.net>
Subject: [PATCH] cmake: pass --sysroot to the core_link_library custom link

add_custom_command links run the bare C compiler, without CMake's
automatic CMAKE_SYSROOT handling, so the libdvdnav wrapper link could
not find crt*.o or libc in a cross build.

Upstream-Status: Pending

---
diff -ruN a/cmake/scripts/linux/Macros.cmake b/cmake/scripts/linux/Macros.cmake
--- a/cmake/scripts/linux/Macros.cmake	2026-07-28 18:07:04
+++ b/cmake/scripts/linux/Macros.cmake	2026-07-28 18:07:04
@@ -38,6 +38,10 @@
   endif()
 
   string(REGEX REPLACE "[ ]+" ";" _flags "${CMAKE_SHARED_LINKER_FLAGS}")
+  # custom commands do not get CMake's automatic --sysroot handling
+  if(CMAKE_SYSROOT)
+    list(APPEND _flags --sysroot=${CMAKE_SYSROOT})
+  endif()
   get_filename_component(dir ${wraplib} DIRECTORY)
   add_custom_command(OUTPUT ${CMAKE_BINARY_DIR}/${wraplib}-${ARCH}${CMAKE_SHARED_MODULE_SUFFIX}
                      COMMAND ${CMAKE_COMMAND} -E make_directory ${dir}
